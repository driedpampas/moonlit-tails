  m_Script: {fileID: 11500000, guid: d1ad2b472319a818b8931a861dd5a52f, type: 3}
  m_Name: Wolf
  m_EditorClassIdentifier: MoonlitTails.Runtime::MoonlitTails.Gameplay.CustomerProfile
  displayName: Wolf
  greetings:
  - Evening. Something to keep me awake.
  - Long night ahead. What have you got?
  story:
  - I drive the night bus. Twelve stops, and nobody ever gets on at the last one.
  - Tonight someone did. Paid in exact change and didn't say a word.
  - They got on again. Turns out they just like the ride. So do I.
  thanks:
  - That hits the spot.
  - Exactly right. Thanks.
  wrong:
  - Hm. Not this one.
  - Close, but that's not it.
  storyDone: My shift's starting. Take care.
