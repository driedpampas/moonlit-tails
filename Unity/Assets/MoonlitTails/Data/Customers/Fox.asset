  m_Script: {fileID: 11500000, guid: d1ad2b472319a818b8931a861dd5a52f, type: 3}
  m_Name: Fox
  m_EditorClassIdentifier: MoonlitTails.Runtime::MoonlitTails.Gameplay.CustomerProfile
  displayName: Fox
  greetings:
  - Yo, bartender. Make it count.
  - Back again. Don't go easy on me.
  story:
  - Band practice ran late. Our drummer quit. Again.
  - Found a new drummer. She plays like a thunderstorm in a teacup.
  - We've got a gig on Friday. You should come. Bring the good glasses.
  thanks:
  - Now that's a drink.
  - Respect.
  wrong:
  - Nah, that's not it.
  - Close, but no encore.
  storyDone: Alright, that's my set. Later.
